# BasicIamOauthClientRotateSecretFlow

main: kit: flow: BasicIamOauthClientRotateSecretFlow:
{
  entity: "iam_oauth_client_rotate_secret",
  kind: "basic",
  name: "BasicIamOauthClientRotateSecretFlow",
  step: [
    {
      i: {
        ref: "iam_oauth_client_rotate_secret_ref01"
      }

      m: {
        account_id: "account01",
        oauth_client_id: "oauth_client01"
      }

      o: "create"
    }
  ],
  "key$": "BasicIamOauthClientRotateSecretFlow"
}