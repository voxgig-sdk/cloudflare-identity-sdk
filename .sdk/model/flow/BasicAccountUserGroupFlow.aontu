# BasicAccountUserGroupFlow

main: kit: flow: BasicAccountUserGroupFlow:
{
  entity: "account_user_group",
  kind: "basic",
  name: "BasicAccountUserGroupFlow",
  step: [
    {
      i: {
        ref: "account_user_group_ref01"
      }

      m: {
        account_id: "account01"
      }

      o: "create"
    }

    {
      m: {
        account_id: "account01"
      }

      o: "list",
      v: [
        {
          apply: "ItemExists",
          def: {
            ref: "account_user_group_ref01"
          }
        }
      ]
    }

    {
      d: {
        account_id: "account01"
      }

      i: {
        ref: "account_user_group_ref01",
        srcdatavar: "account_user_group_ref01_data",
        suffix: "_up0",
        textfield: "name"
      }

      o: "update",
      s: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-account_user_group_ref01"
          }
        }
      ]
    }

    {
      i: {
        ref: "account_user_group_ref01",
        srcdatavar: "account_user_group_ref01_data",
        suffix: "_dt0"
      }

      m: {
        account_id: "account01",
        id: "account_user_group01"
      }

      o: "load",
      v: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-account_user_group_ref01"
          }
        }
      ]
    }
  ],
  "key$": "BasicAccountUserGroupFlow"
}